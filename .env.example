# Public RevenueCat Test Store SDK key used by Preview API Mode in Expo Go.
# This is a public client key, never a RevenueCat secret key.
EXPO_PUBLIC_REVENUECAT_API_KEY=test_replace_with_your_public_sdk_key

# Phone-reachable FastAPI URL. Never use localhost for a physical device.
# Replace this placeholder whenever your LAN address or Quick Tunnel changes.
EXPO_PUBLIC_API_BASE_URL=https://your-api-host.example.com
