# Public RevenueCat Test Store SDK key used by Preview API Mode in Expo Go.
# This is intentionally a public client key, never a RevenueCat secret key.
EXPO_PUBLIC_REVENUECAT_API_KEY=test_replace_with_your_public_sdk_key

# FastAPI server URL. A physical phone must use the Mac's LAN IP, not localhost.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000
