# Existing FUTURIUM_* names are retained for backend configuration compatibility.

# Directory for manifests, retained frames, thumbnails, and embedding indexes.
FUTURIUM_DATA_DIR=./data

# Maximum accepted video upload size in bytes (default: 100 MiB).
FUTURIUM_MAX_UPLOAD_BYTES=104857600

# Frame processing controls.
FUTURIUM_SAMPLE_FPS=2
FUTURIUM_BLUR_THRESHOLD=100
FUTURIUM_DUPLICATE_HASH_DISTANCE=5
FUTURIUM_THUMBNAIL_WIDTH=320
FUTURIUM_PROCESS_TIMEOUT_SECONDS=180

# OpenCLIP semantic search. The first real run downloads model weights.
FUTURIUM_EMBEDDING_MODEL=ViT-B-32
FUTURIUM_EMBEDDING_PRETRAINED=laion2b_s34b_b79k
# auto selects Apple Metal (MPS), then CUDA, then CPU.
FUTURIUM_EMBEDDING_DEVICE=auto
FUTURIUM_SEARCH_CONFIDENCE_THRESHOLD=0.23

# Server-only Gemini key for optional voice transcription. Never expose it in Expo.
GEMINI_API_KEY=replace_with_your_gemini_api_key
FUTURIUM_GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
FUTURIUM_MAX_AUDIO_UPLOAD_BYTES=5242880
