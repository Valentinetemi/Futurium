{
  "expo": {
    "name": "FoundIt",
    "slug": "foundit",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "foundit",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.valentinetemi.futurium"
    },
    "android": {
      "package": "com.valentinetemi.futurium",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FoundIt to record visual memories of your spaces.",
          "microphonePermission": "Allow FoundIt to include sound in room sweeps.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-video",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow FoundIt to record audio for room sweeps and short voice searches.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
